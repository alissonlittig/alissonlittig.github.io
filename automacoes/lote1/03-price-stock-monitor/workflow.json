      "id": "e7fd6401-0098-5177-b224-b0224163f4c3",
      "name": "Extract name/price/stock",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $('Config').first().json.data_dir + '/' + $('Config').first().json.snapshot_file }}",
        "options": {}
      },
      "id": "608d6924-42ce-5084-b83d-25b21fe2601a",
      "name": "Read last snapshot",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "First run: file does not exist yet, so this node continues and the next one treats it as a baseline.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const cur = $('Extract name/price/stock').first().json;\nconst num = s => Number(String(s).replace(/[^0-9,.]/g, '').replace(/\\.(?=\\d{3}\\b)/g, '').replace(',', '.')) || 0;\nconst now = {name: cur.name, price: num(cur.price), stock: parseInt(cur.stock) || 0, checked_at: new Date().toISOString()};\nconst it = $input.first();\nlet changes = [], first = true;\nif (it.binary && it.binary.data) {\n  first = false;\n  const old = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'));\n  if (old.price !== now.price) changes.push(`price ${old.price} -> ${now.price}` + (now.price < old.price ? ' (DROP)' : ' (rise)'));\n  if (old.stock !== now.stock) changes.push(`stock ${old.stock} -> ${now.stock}` + (now.stock === 0 ? ' (SOLD OUT)' : old.stock === 0 ? ' (BACK IN STOCK)' : ''));\n}\nconst bin = await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(now, null, 2), 'utf8'), 'price_snapshot.json', 'application/json');\nreturn [{json: {now, first, changed: changes.length > 0, changes: changes.join('; '), text: `${now.name}: ${changes.join('; ')}`}, binary: {data: bin}}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "3b58a2d3-be09-509f-9000-d49e4b7ee673",
      "name": "Compare with last",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Config').first().json.data_dir + '/' + $('Config').first().json.snapshot_file }}",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "67f258a7-a4b8-5610-a3fd-a9baa34b6a0b",
      "name": "Save new snapshot",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3f310f32-6d6d-5b3e-b1cc-23f3d991c626",
              "leftValue": "={{ $('Compare with last').first().json.changed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "666af6a9-07fe-56a3-8177-5ac117d7a673",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
