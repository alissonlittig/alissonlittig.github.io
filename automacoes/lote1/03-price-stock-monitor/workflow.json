        "url": "={{ $('Config').first().json.notify_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({chat_id: $('Config').first().json.notify_chat_id, text: 'PRICE/STOCK ALERT - ' + $('Compare with last').first().json.text}) }}",
        "options": {}
      },
      "id": "952a51f1-4acc-510e-94cd-9ca64be3f114",
      "name": "Notify (Telegram-compatible)",
