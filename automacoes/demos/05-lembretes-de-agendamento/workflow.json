        "options": {}
      },
      "id": "0374db3a-b456-587c-8f7c-a1561db0e4bf",
      "name": "CSV to rows",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const q = v => '\"' + String(v ?? '').replace(/\"/g, '\"\"').replace(/[\\r\\n]+/g, ' ') + '\"';\n\nconst cfg = $('Config').first().json;\nconst base = cfg.today ? new Date(cfg.today + 'T00:00:00Z') : new Date();\nbase.setUTCDate(base.getUTCDate() + 1);\nconst target = base.toISOString().slice(0, 10);\nconst rows = $input.all().map(i => i.json).filter(r => r.date === target);\nif (!rows.length) return [{json: {count: 0, target, text: `No appointments on ${target}.`}}];\nconst lines = rows.map(r => {\n  const msg = `Olá, ${r.client.split(' ')[0]}! Lembrete: ${r.service} amanhã às ${r.time} no ${cfg.business_name}. Responda 1 para confirmar ou 2 para remarcar.`;\n  return [target, r.time, r.client, r.phone, r.service, 'https://wa.me/' + r.phone + '?text=' + encodeURIComponent(msg), msg].map(q).join(',');\n});\nconst csv = lines.join('\\n') + '\\n';\nconst bin = await this.helpers.prepareBinaryData(Buffer.from(csv, 'utf8'), 'reminders_outbox.csv', 'text/csv');\nreturn [{json: {count: rows.length, target, text: `${rows.length} reminder(s) queued for ${target}: ` + rows.map(r => r.time + ' ' + r.client).join(', ')}, binary: {data: bin}}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "7d1913ef-8229-533b-a5d0-81a191294a79",
      "name": "Pick tomorrow + write messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
