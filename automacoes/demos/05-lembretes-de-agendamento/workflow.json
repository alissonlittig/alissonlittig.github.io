            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "0039f587-e124-5bdf-b78d-487f468598bf",
              "leftValue": "={{ $('Pick tomorrow + write messages').first().json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
