      "id": "49970f41-1cc0-5095-95d3-1ff30f5bcbb3",
      "name": "Read invoice PDFs",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        460,
        260
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {
          "keepSource": "binary"
        }
      },
      "id": "826f9b5d-b75a-501b-a55e-997a0e0bccb7",
      "name": "Extract text from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        680,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const num = s => s ? Number(String(s).replace(/,/g, '')) : null;\nreturn $input.all().map(i => {\n  const t = String(i.json.text || '').replace(/\\s+/g, ' ');\n  const file = (i.binary && i.binary.data && i.binary.data.fileName) || 'unknown.pdf';\n  const m = (re) => { const r = t.match(re); return r ? r[1] : null; };\n  const vendor = m(/^(.*?)\\s*Fictional sample/i) || m(/^(.{3,40}?)\\s+INVOICE/i);\n  const tot = t.match(/Total(?: due)?:\\s*([A-Z]{3})\\s*([\\d,]+\\.\\d{2})/i);\n  const inv = {file, vendor, invoice_no: m(/Invoice\\s*(?:No\\.?|#|Number)\\s*[:\\-]?\\s*([A-Z0-9-]+)/i), date: m(/(?:Invoice date|Date)\\s*:\\s*(\\d{4}-\\d{2}-\\d{2})/i),\n    currency: tot ? tot[1] : null, subtotal: num(m(/Subtotal:\\s*([\\d,]+\\.\\d{2})/i)), tax: num(m(/(?:VAT|Tax):\\s*([\\d,]+\\.\\d{2})/i)), total: tot ? num(tot[2]) : null};\n  const issues = [];\n  ['vendor', 'invoice_no', 'date', 'total'].forEach(k => { if (!inv[k]) issues.push('missing ' + k); });\n  if (inv.subtotal != null && inv.total != null && Math.abs(inv.subtotal + (inv.tax || 0) - inv.total) > 0.01) issues.push(`total mismatch (${inv.subtotal} + ${inv.tax || 0} != ${inv.total})`);\n  return {json: {...inv, issues}};\n});\n",
        "mode": "runOnceForAllItems"
      },
      "id": "71d1909d-3c14-5dc7-9f61-932871fe1d1e",
      "name": "Parse invoice fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json: {rows: $input.all().map(i => i.json)}}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "15745f37-ae29-5146-870a-9c35daa75d3d",
      "name": "Collect all invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        260
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $('Config').first().json.data_dir + '/invoices*.csv' }}",
        "options": {}
      },
      "id": "5d41f77a-3bbe-50c3-b147-d5492058e454",
      "name": "Read existing invoices.csv",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1340,
        260
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "Glob reads invoices.csv and invoices_review.csv, so a PDF already booked or already in review is not processed twice.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const q = v => '\"' + String(v ?? '').replace(/\"/g, '\"\"').replace(/[\\r\\n]+/g, ' ') + '\"';\n\nconst rows = $('Collect all invoices').first().json.rows;\nconst seen = new Set();\nconst all = $input.all();\nfor (let n = 0; n < all.length; n++) {\n  if (!(all[n].binary && all[n].binary.data)) continue;\n  const txt = (await this.helpers.getBinaryDataBuffer(n, 'data')).toString('utf8');\n  txt.split(/\\r?\\n/).slice(1).filter(Boolean).forEach(l => { const c = l.split('\",\"'); seen.add((c[1] || '').replace(/\"/g, '') + '|' + (c[0] || '').replace(/\"/g, '')); });\n}\nconst out = [];\nfor (const r of rows) {\n  const key = r.vendor + '|' + r.invoice_no;\n  let route = r.issues.length ? 'review' : 'ok';\n  if (r.invoice_no && seen.has(key)) route = 'duplicate';\n  else if (route === 'ok') seen.add(key);\n  const line = ['invoice_no', 'vendor', 'date', 'currency', 'subtotal', 'tax', 'total', 'file'].map(k => q(r[k])).join(',') + ',' + q(route === 'review' ? r.issues.join('; ') : '') + '\\n';\n  const bin = await this.helpers.prepareBinaryData(Buffer.from(line, 'utf8'), 'line.csv', 'text/plain');\n  out.push({json: {...r, route}, binary: {data: bin}});\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
      },
      "id": "1461c20c-0458-5457-b424-6d191e7fac0c",
      "name": "Route: ok / review / duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ]
    },
