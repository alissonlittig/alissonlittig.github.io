      ]
    },
    {
      "parameters": {},
      "id": "c4eafab6-e750-51af-a816-963a6a694e1e",
      "name": "Skip duplicate (no write)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2000,
        440
      ],
      "notes": "Same vendor + invoice number already booked.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Route: ok / review / duplicate').all().map(i => i.json);\nconst ok = rows.filter(r => r.route === 'ok'), rv = rows.filter(r => r.route === 'review'), du = rows.filter(r => r.route === 'duplicate');\nconst sum = ok.reduce((a, r) => a + r.total, 0).toFixed(2);\nconst text = `Invoices: ${ok.length} booked (USD ${sum}), ${rv.length} sent to review (${rv.map(r => r.file + ': ' + r.issues.join(', ')).join(' | ')}), ${du.length} duplicate skipped (already booked or in review).`;\nreturn [{json: {text, booked: ok.length, review: rv.length, duplicate: du.length}}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "829aaab7-3ae3-5897-a401-fd62b10e40f8",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        480
      ]
    },
