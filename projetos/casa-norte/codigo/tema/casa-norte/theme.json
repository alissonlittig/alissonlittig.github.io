{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1180px" },
    "color": {
      "palette": [
        { "slug": "mist", "name": "Mist", "color": "#F2F4F1" },
        { "slug": "ink", "name": "Ink", "color": "#10212B" },
        { "slug": "sea", "name": "Sea", "color": "#0F5C63" },
        { "slug": "sand", "name": "Sand", "color": "#E7DDCB" },
        { "slug": "brass", "name": "Brass", "color": "#B98A3A" },
        { "slug": "navy", "name": "Navy", "color": "#0B2433" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "display", "name": "Fraunces", "fontFamily": "'Fraunces', Georgia, serif",
          "fontFace": [{ "fontFamily": "Fraunces", "fontWeight": "100 900", "fontStyle": "normal", "src": ["file:./assets/fonts/fraunces-latin-wght-normal.woff2"] }] },
        { "slug": "body", "name": "Inter", "fontFamily": "'Inter', system-ui, sans-serif",
          "fontFace": [{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-latin-wght-normal.woff2"] }] }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.65" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.08" } },
      "link": { "color": { "text": "var(--wp--preset--color--sea)" } }
    }
  }
}
